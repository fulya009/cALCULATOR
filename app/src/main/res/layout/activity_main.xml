<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:padding="12dp">

    <!-- Input panel: shows name+ID on startup, then the expression/result -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="bottom|end"
        android:textSize="34sp"
        android:textColor="@color/text_dark"
        android:padding="16dp"
        android:text="" />

    <!-- Row 1: C ( ) / -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btnC"      android:text="C" android:onClick="onClear"
            android:backgroundTint="@color/key_c"        android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnOpen"   android:text="(" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnClose"  android:text=")" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnDiv"    android:text="/" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Row 2: 7 8 9 * -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn7" android:text="7" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn8" android:text="8" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn9" android:text="9" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnMul" android:text="*" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Row 3: 4 5 6 + -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn4" android:text="4" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn5" android:text="5" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn6" android:text="6" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnAdd" android:text="+" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Row 4: 1 2 3 - -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn1" android:text="1" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn2" android:text="2" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn3" android:text="3" android:onClick="onInput"
            android:backgroundTint="@color/key_digit" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnSub" android:text="-" android:onClick="onInput"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Row 5: AC 0 . = -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btnAC" android:text="AC" android:onClick="onAllClear"
            android:backgroundTint="@color/key_ac"      android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn0" android:text="0" android:onClick="onInput"
            android:backgroundTint="@color/key_zero"    android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnDot" android:text="." android:onClick="onInput"
            android:backgroundTint="@color/key_digit"   android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnEquals" android:text="=" android:onClick="onEquals"
            android:backgroundTint="@color/key_operator" android:textColor="@color/text_light"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"/>
    </LinearLayout>

</LinearLayout>